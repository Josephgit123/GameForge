// GameForge Prisma schema.
// Every model, column, and relationship here is transcribed from
// docs/DATABASE.md (itself transcribed from CLAUDE.md's schema section).
// Anything marked "(proposed)" in DATABASE.md — id type, enum value sets,
// relationship cardinality, the WebhookEvent unique key — is implemented
// here as proposed, and is NOT independently re-decided in this file.
// If you change a modeling decision, update DATABASE.md first.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PUBLISHER
  ADMIN
}

enum PublisherStatus {
  PENDING
  APPROVED
  REJECTED
}

// (proposed) exact values not specified in CLAUDE.md — see docs/DATABASE.md
enum GameStatus {
  DRAFT
  PUBLISHED
  DELISTED
}

// (proposed) exact values not specified in CLAUDE.md — see docs/DATABASE.md
enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// (proposed) exact values not specified in CLAUDE.md — see docs/DATABASE.md
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

// (proposed) exact values not specified in CLAUDE.md — see docs/DATABASE.md
enum RefundStatus {
  REQUESTED
  APPROVED
  COMPLETED
  REJECTED
}

// (proposed) exact values not specified in CLAUDE.md — see docs/DATABASE.md
enum GiftCardStatus {
  ACTIVE
  DEPLETED
  EXPIRED
}

// (proposed) exact values not specified in CLAUDE.md — see docs/DATABASE.md
enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  role         Role
  firstName    String
  lastName     String

  publisher      Publisher?
  orders         Order[]        @relation("CustomerOrders")
  libraryEntries LibraryEntry[]
}

model Publisher {
  id                     String          @id @default(uuid())
  userId                 String          @unique
  surfboardMerchantId    String?
  surfboardApplicationId String?
  // Returned alongside applicationId by Create Merchant — the real KYB
  // verification link Surfboard expects the merchant to complete.
  webKybUrl              String?
  status                 PublisherStatus @default(PENDING)

  user   User    @relation(fields: [userId], references: [id])
  stores Store[]
  games  Game[]
}

model Store {
  id                  String  @id @default(uuid())
  publisherId         String
  surfboardStoreId    String
  // Registered once, right after MERCHANT_CREATED — an order can't be
  // created against a store with no online terminal (see
  // services/surfboard.ts#registerOnlineTerminal).
  surfboardTerminalId String?

  publisher Publisher @relation(fields: [publisherId], references: [id])
}

model Game {
  id                 String     @id @default(uuid())
  publisherId        String
  title              String
  description        String
  price              Int
  currency           String
  status             GameStatus @default(DRAFT)
  coverImageUrl      String?
  // Short looping real video (via Pexels) used only by the hero carousel —
  // generic thematic stock footage, not gameplay capture. Cards/grids never
  // render this (autoplaying video across 100+ grid items would be heavy).
  coverVideoUrl      String?
  genre              String?
  platform           String?
  screenshotUrls     String[]  @default([])
  systemRequirements String?
  createdAt          DateTime  @default(now())

  publisher      Publisher      @relation(fields: [publisherId], references: [id])
  orderItems     OrderItem[]
  libraryEntries LibraryEntry[]
}

model Order {
  id               String      @id @default(uuid())
  customerId       String
  surfboardOrderId String?
  status           OrderStatus @default(PENDING)
  totalAmount      Int
  currency         String
  createdAt        DateTime    @default(now())
  // Which Surfboard merchant/terminal actually processed this order — the
  // publisher's own once onboarded, otherwise the shared demo fallback.
  // Refunds/receipts must reuse the SAME merchant an order was created
  // under, not whichever is "current" at the time.
  surfboardMerchantId String?
  surfboardTerminalId String?

  customer           User                 @relation("CustomerOrders", fields: [customerId], references: [id])
  items              OrderItem[]
  payments           Payment[]
  refunds            Refund[]
  libraryEntries     LibraryEntry[]
  giftCardRedemption GiftCardRedemption?
  promotionUsage     PromotionUsage?
}

model OrderItem {
  id              String @id @default(uuid())
  orderId         String
  gameId          String
  priceAtPurchase Int

  order Order @relation(fields: [orderId], references: [id])
  game  Game  @relation(fields: [gameId], references: [id])
}

model Payment {
  id                 String        @id @default(uuid())
  orderId            String
  surfboardPaymentId String
  status             PaymentStatus @default(PENDING)
  method             String

  order Order @relation(fields: [orderId], references: [id])
}

model Refund {
  id                String       @id @default(uuid())
  orderId           String
  surfboardRefundId String?
  status            RefundStatus @default(REQUESTED)
  reason            String
  amount            Int

  order Order @relation(fields: [orderId], references: [id])
}

model LibraryEntry {
  id         String   @id @default(uuid())
  customerId String
  gameId     String
  orderId    String
  acquiredAt DateTime @default(now())

  customer User  @relation(fields: [customerId], references: [id])
  game     Game  @relation(fields: [gameId], references: [id])
  order    Order @relation(fields: [orderId], references: [id])
}

model GiftCard {
  id                  String         @id @default(uuid())
  surfboardGiftCardId String
  code                String         @unique
  initialBalance      Int
  currentBalance      Int
  status              GiftCardStatus @default(ACTIVE)

  redemptions GiftCardRedemption[]
}

model GiftCardRedemption {
  id            String @id @default(uuid())
  giftCardId    String
  orderId       String @unique
  amountApplied Int

  giftCard GiftCard @relation(fields: [giftCardId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])
}

model Promotion {
  id String @id @default(uuid())
  // Nullable: Surfboard's real Promotions API is a marketing-banner system
  // (receipt/idle-screen display), not a discount-code system — there's no
  // real Surfboard entity to reference here. Confirmed live; see
  // docs/API_INTEGRATION.md#promotion-api. This is local-only business logic.
  surfboardPromotionId String?
  code                 String        @unique
  type                 PromotionType
  value                Int
  startsAt             DateTime
  endsAt               DateTime
  usageLimit           Int

  usages PromotionUsage[]
}

model PromotionUsage {
  id              String @id @default(uuid())
  promotionId     String
  orderId         String @unique
  discountApplied Int

  promotion Promotion @relation(fields: [promotionId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])
}

model WebhookEvent {
  id                   String    @id @default(uuid())
  // Confirmed live from Surfboard's webhook payload (metadata.eventId) —
  // a genuine unique event ID, not a guessed composite key. This is the
  // real idempotency key; see docs/DATABASE.md#idempotency-pattern.
  surfboardEventId     String    @unique
  eventType            String
  surfboardReferenceId String
  payload              Json
  processedAt          DateTime?
}

// Read-only reference data imported from the RAWG Video Games Database API
// (https://rawg.io/apidocs), for a non-commercial "Discover" browsing
// surface. Deliberately has NO relation to Game/Order/OrderItem/Payment/
// LibraryEntry — nothing in this table is or can become purchasable
// inventory. See server/src/services/rawg.ts.
model RawgGame {
  id          String   @id @default(uuid())
  rawgId      Int      @unique
  slug        String
  name        String
  description String?
  backgroundImage String?
  released    String?
  rating      Float?
  metacritic  Int?
  esrbRating  String?
  genres      String[] @default([])
  platforms   String[] @default([])
  importedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
