# ==============================================================================
# GameForge — Environment Variables
# ==============================================================================
# This file documents every env var used across server/ and client/.
# Copy the relevant sections into server/.env and client/.env (Vite only reads
# vars from client/.env, and only ones prefixed VITE_). Never commit real .env
# files — only this .env.example.
# ==============================================================================


# ------------------------------------------------------------------------------
# server/.env
# ------------------------------------------------------------------------------

# Node environment. Controls logging verbosity and error detail in responses.
NODE_ENV=development

# Port the Express API listens on.
PORT=4000

# Postgres connection string Prisma uses for migrations and queries.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gameforge?schema=public

# Secret used to sign/verify JWTs issued at login. Use a long random string,
# never reuse across environments.
JWT_SECRET=replace-with-a-long-random-string

# How long an issued JWT stays valid (jsonwebtoken "expiresIn" format).
JWT_EXPIRES_IN=1d

# Origin(s) allowed to call the API from the browser (CORS). Matches wherever
# the Vite dev server runs.
CORS_ORIGIN=http://localhost:5173

# --- Surfboard Payments (sandbox) ---
# All Surfboard-facing values below are consumed exclusively by
# server/src/services/surfboard.ts — see docs/API_INTEGRATION.md.

# Base API URL — confirmed from the Developer Portal Console. Same host for
# both Demo and Live environments; which one you hit is determined by which
# API key/secret pair you use, not the URL.
SURFBOARD_API_BASE_URL=https://carbon.surfgw.com/api

# API key issued in the Surfboard Developer Portal Console (sandbox).
SURFBOARD_API_KEY=replace-with-sandbox-api-key

# API secret paired with the key above. NOTE: CLAUDE.md flags that the exact
# auth header scheme (how key+secret are combined into a request header) is
# unconfirmed — verify against the Postman collection before implementing.
SURFBOARD_API_SECRET=replace-with-sandbox-api-secret

# Your platform's Surfboard partner ID — the {partnerId} path segment used in
# Merchant API calls (POST/GET /partners/{partnerId}/merchants...).
SURFBOARD_PARTNER_ID=replace-with-partner-id

# Shared secret (or signing key) Surfboard uses to sign webhook payloads.
# Used by the webhook receiver to verify authenticity before processing.
# Confirm the exact verification scheme (header name, HMAC algorithm) against
# Surfboard's webhook docs.
SURFBOARD_WEBHOOK_SECRET=replace-with-webhook-signing-secret

# Publicly reachable URL Surfboard sends webhooks to (e.g. an ngrok URL in
# local dev, or your real domain in a deployed environment).
SURFBOARD_WEBHOOK_URL=https://your-public-url.example.com/api/webhooks/surfboard

# Merchant ID for the pre-approved sandbox merchant used to drive demo
# catalog/checkout flows, since real KYB review takes 3-4 business days.
# See docs/API_INTEGRATION.md "KYB timing constraint".
SURFBOARD_DEMO_FALLBACK_MERCHANT_ID=replace-with-preapproved-merchant-id

# Default store ID returned alongside the merchant ID above once that
# merchant reached MERCHANT_CREATED. Used to seed the demo Publisher's
# default Store row.
SURFBOARD_DEMO_FALLBACK_STORE_ID=replace-with-preapproved-store-id

# PaymentPage-mode online terminal registered under the store above (see
# POST /merchants/:merchantId/stores/:storeId/online-terminals). Register
# once and reuse — registration is not idempotent, it mints a new terminal
# every time it's called.
SURFBOARD_DEMO_TERMINAL_ID=replace-with-registered-terminal-id

# --- Google sign-in (Firebase) ---
# Service account credentials from Firebase Console > Project Settings >
# Service Accounts > Generate new private key. Used server-side only, to
# verify Google ID tokens the client sends after Firebase sign-in. Never
# commit the real values — see docs/SETUP.md for how to obtain them.
# If unset, POST /auth/google responds 503 instead of the server failing to boot.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-firebase-service-account-email
# Paste the private_key field from the service account JSON verbatim,
# including the literal \n line breaks — this file keeps it as one line.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-key\n-----END PRIVATE KEY-----\n"


# ------------------------------------------------------------------------------
# client/.env
# ------------------------------------------------------------------------------

# Base URL the React app uses to call the Express API. Vite only exposes vars
# prefixed VITE_ to browser code.
VITE_API_BASE_URL=http://localhost:4000

# --- Google sign-in (Firebase) ---
# Web app config from Firebase Console > Project Settings > General > Your apps
# > Web app > SDK setup and configuration > Config. These are public client
# identifiers (safe to ship in the bundle) — the private key above is what
# must stay secret. If unset, the "Continue with Google" button is hidden.
VITE_FIREBASE_API_KEY=replace-with-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
VITE_FIREBASE_APP_ID=replace-with-firebase-app-id
